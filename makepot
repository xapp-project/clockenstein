#!/bin/bash

xgettext --language=Desktop \
    --output=clockenstein.pot \
    data/org.x.clockenstein.Calendar.desktop.in \
    data/org.x.clockenstein.Clocks.desktop.in

xgettext --join-existing \
    --output=clockenstein.pot \
    data/org.x.clockenstein.Calendar.metainfo.xml.in \
    data/org.x.clockenstein.Clocks.metainfo.xml.in

xgettext --language=Python \
    --join-existing \
    --from-code=UTF-8 \
    --keyword=_ \
    --keyword=N_ \
    --output=clockenstein.pot \
    calendar/*.py calendar/backends/*.py calendar/views/*.py calendar/widgets/*.py \
    clocks/*.py daemon/*.py agent/*.py clockenstein/*.py
